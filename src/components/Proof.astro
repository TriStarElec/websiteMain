// ==============================
// src/components/Proof.astro
// ==============================
---
const proof = [
  { k: 'Comms', v: 'You’ll know what’s happening.' },
  { k: 'Finish', v: 'Straight lines, clean plates, no mess.' },
  { k: 'Trust', v: 'Licensed work, documented, compliant.' },
];
---
<section class="section section--alt" id="work">
  <div class="container">
    <div class="section__head">
      <h2 class="h2">Why Tri Star</h2>
      <p class="muted">We’re the crew you call when “good enough” isn’t.</p>
    </div>

    <div class="proof">
      {proof.map((p) => (
        <div class="proof__item">
          <div class="proof__k mono">{p.k}</div>
          <div class="proof__v">{p.v}</div>
        </div>
      ))}

      <div class="proof__grid">
        <div class="photo" role="img" aria-label="Work photo placeholder">
          <div class="photo__label mono">Replace with real job photos</div>
          <div class="photo__shape"></div>
        </div>
        <div class="photo" role="img" aria-label="Work photo placeholder">
          <div class="photo__label mono">Switchboard tidy / lighting / EV</div>
          <div class="photo__shape"></div>
        </div>
      </div>
    </div>
  </div>
</section>