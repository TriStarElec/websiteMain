// ==============================
// src/components/PricingTease.astro
// ==============================
---
const points = [
  'Upfront options (good / better / best).',
  'Fixed-price where possible.',
  'If we find surprises: we stop, show you, price it, then proceed.',
];
---
<section class="section section--alt" id="pricing">
  <div class="container">
    <div class="pricing">
      <div>
        <h2 class="h2">Pricing without the weirdness</h2>
        <p class="p">Transparent scope, tidy documentation, and a clean invoice that matches the plan.</p>
        <ul class="bullets">
          {points.map((p) => (<li>{p}</li>))}
        </ul>
      </div>
      <div class="pricing__box">
        <div class="pricing__top">
          <div class="mono">Common starts</div>
          <div class="pricing__stamp">NO SURPRISES</div>
        </div>
        <div class="pricing__items">
          <div class="pricing__item"><span>Lighting upgrade consult</span><span class="mono">from $</span></div>
          <div class="pricing__item"><span>Fault-find visit</span><span class="mono">from $</span></div>
          <div class="pricing__item"><span>Switchboard assessment</span><span class="mono">from $</span></div>
        </div>
        <div class="muted small">Replace “from $” with your real starting prices when ready.</div>
      </div>
    </div>
  </div>
</section>