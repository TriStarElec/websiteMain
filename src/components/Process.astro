// ==============================
// src/components/Process.astro
// ==============================
---
const steps = [
  { n: '01', t: 'Send details', d: 'A short form. Photos help. We reply fast.' },
  { n: '02', t: 'Scope + price', d: 'Clear options. No hidden extras.' },
  { n: '03', t: 'Do the work', d: 'On time, tidy, respectful in your home.' },
  { n: '04', t: 'Sign-off', d: 'Photos, notes, and compliance where required.' },
];
---
<section class="section" id="process">
  <div class="container">
    <div class="section__head">
      <h2 class="h2">Process</h2>
      <p class="muted">Simple. Predictable. Built for busy households.</p>
    </div>

    <ol class="steps">
      {steps.map((s) => (
        <li class="step">
          <div class="step__n mono">{s.n}</div>
          <div>
            <div class="step__t">{s.t}</div>
            <div class="step__d muted">{s.d}</div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>