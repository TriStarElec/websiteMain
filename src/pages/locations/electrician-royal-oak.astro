---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Royal Oak",
  city: "Auckland",
  slug: "electrician-royal-oak",
  canonical: "https://tristarelectrical.co.nz/locations/electrician-royal-oak",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Royal Oak homes range from early bungalows to modern townhouses wrapped around local shops. Power demands are rising — EV chargers, home offices, spa circuits — so we upgrade switchboards, add circuits, and keep documentation tidy. We schedule around school drop-offs by Onehunga High, work weekends if retailers need it, and clean up so your place is livable between phases. When you log a job we ask for photos and desired timelines, then turn up with the gear to finish in one visit. Expect respectful communication, labelled circuits, and compliance certificates emailed straight after the job.",
  nearby: ["One Tree Hill", "Onehunga", "Epsom", "Greenlane", "Hillsborough"],
  faqs: [
    {
      q: "Can you help with pre-sale electrical tidy-ups?",
      a: "Yes. We fix noted faults, supply compliance paperwork, and provide photos for your seller’s pack.",
    },
    {
      q: "Do you install EV chargers for shared driveways?",
      a: "We assess available capacity, add load management, and keep cabling neat so neighbours can still maneuver.",
    },
    {
      q: "What about adding power to granny flats?",
      a: "We run new submains, install RCD protection, and certify the work for council sign-off.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Royal Oak electricians for family homes and shops — upgrades, EV chargers, outdoor power, and fast documentation.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central South • Family & Retail</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard upgrades ahead of renovations</li>
            <li>Outdoor + spa power for backyard makeovers</li>
            <li>EV charger installs for carports</li>
            <li>Retail maintenance and lighting refreshes</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
