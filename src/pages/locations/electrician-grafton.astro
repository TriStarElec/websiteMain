---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Grafton",
  city: "Auckland",
  slug: "electrician-grafton",
  canonical: "https://tristarelectrical.co.nz/locations/electrician-grafton",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Grafton sits beside Auckland Hospital and the university precinct, so electrical work must respect medical schedules, research facilities, and heritage apartments. We plan shutdowns with facility managers, provide RAMS paperwork, and keep noise low for clinics and short-stay accommodation. In apartments and villas we upgrade protection, add power for home offices, and keep documentation tidy for landlords. We also manage UPS circuits, lab equipment, and student housing maintenance — always communicating early so stakeholders stay in the loop. Expect punctual trades, detailed reporting, and testing that meets medical and education standards.",
  nearby: ["Newmarket", "Parnell", "Epsom", "Auckland Central", "Mt Eden"],
  faqs: [
    {
      q: "Do you work with hospital or university teams?",
      a: "Yes. We coordinate with DHB engineering and campus facilities, providing RAMS, inductions, and post-job reports.",
    },
    {
      q: "Can you handle heritage apartments?",
      a: "We plan containment carefully, label circuits, and keep stairwells tidy so neighbours aren’t disturbed.",
    },
    {
      q: "What about UPS or lab equipment?",
      a: "We test load, provide bypass options, and schedule work after hours when sensitive gear can be powered down.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Grafton electricians for hospitals, labs, and apartments — compliant paperwork, careful installs, and fast communication.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central Auckland • Medical & Education</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>UPS + lab circuit maintenance</li>
            <li>Switchboard upgrades in heritage apartments</li>
            <li>Lighting + power for clinics + lecture spaces</li>
            <li>Fast repairs for student housing</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
