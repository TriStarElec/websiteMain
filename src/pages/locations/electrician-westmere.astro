---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Westmere",
  city: "Auckland",
  slug: "electrician-westmere",
  canonical: "https://tristarelectrical.co.nz/locations/electrician-westmere",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Westmere blends renovated bungalows, architect-designed additions, and quiet harbour streets that expect respectful trades. We handle everything from rewiring villas near the zoo to installing garden lighting around Meola Reef. Our electricians coordinate with builders on extensions, run new mains for studios, and keep noise low for clients working remotely. When we finish, you get detailed photos, labelling, and compliance paperwork so your home is ready for valuation or insurance. We also help manage EV charging, spa circuits, and solar-ready switchboards so your property stays future-proof.",
  nearby: ["Grey Lynn", "Point Chevalier", "Herne Bay", "Westmere Peninsula", "Meola"],
  faqs: [
    {
      q: "Can you work around school pickup traffic?",
      a: "Yes. We schedule arrivals outside peak times so our vans don’t choke narrow streets or shared driveways.",
    },
    {
      q: "Do you install outdoor lighting for coastal boardwalks?",
      a: "We design low-profile lighting with corrosion-resistant fittings suited to the harbour environment.",
    },
    {
      q: "What if we’re mid-renovation?",
      a: "We’ll align with your builder, provide clear stage pricing, and keep the site tidy between visits.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Westmere electricians who respect villas and new builds — rewires, outdoor lighting, EV chargers, and tidy workmanship.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Inner West • Villas & Extensions</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Rewires + board upgrades for villas</li>
            <li>Studio + home office circuits</li>
            <li>Outdoor + garden lighting near the harbour</li>
            <li>EV charger installs for tandem parking</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
