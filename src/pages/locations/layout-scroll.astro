---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = Astro.props?.suburb ?? "Sample Suburb";
const slug = Astro.props?.slug ?? "sample-suburb";

const panels = [
  { title: `Electrician ${suburb}`, text: `Lead panel with bold claim + CTA for ${suburb}.` },
  { title: "Services", text: "List top three services relevant to the suburb." },
  { title: "Proof", text: "Placeholder for future reviews/photos." },
  { title: "CTA", text: "Final contact prompt with phone + form." },
];
---

<BaseLayout title={`Electrician ${suburb} — Scroll Concept`} description="Scroll-snapping panels with full-height sections">
  <main class="scrollLayout" id="scrollLayout">
    {panels.map((panel, index) => (
      <section class={`panel panel-${index+1}`}>
        <div>
          <h1>{panel.title}</h1>
          <p>{panel.text}</p>
          {index === 0 && <a class="btn" href={`/contact?suburb=${slug}`}>Book now</a>}
          {index === panels.length - 1 && <a class="btn" href={`/locations/auckland/${slug}`}>View suburb page</a>}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .scrollLayout { height:100vh; overflow-y:scroll; scroll-snap-type:y mandatory; font-family:"Space Grotesk",sans-serif; }
  .panel { height:100vh; scroll-snap-align:start; display:grid; place-items:center; text-align:center; padding:2rem; }
  .panel div { max-width:460px; }
  .panel-1 { background:#05060a; color:#fefefe; }
  .panel-2 { background:#f5f2eb; color:#0b0c10; }
  .panel-3 { background:#11131d; color:#f3f3f3; }
  .panel-4 { background:#0b0c10; color:#ffe5ba; }
  .btn { margin-top:1rem; padding:.9rem 1.6rem; border-radius:999px; border:1px solid currentColor; color:inherit; text-decoration:none; display:inline-flex; justify-content:center; }
</style>
