---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = Astro.props?.suburb ?? "Sample Suburb";
const slug = Astro.props?.slug ?? "sample-suburb";

const columns = [
  { title: "Sidebar", text: `Sticky CTA + quick links for ${suburb}.` },
  { title: "Case studies", text: `Scrollable content feed for recent ${suburb} jobs.` },
  { title: "Media", text: "Drop in gallery or map." },
];
---

<BaseLayout title={`Electrician ${suburb} — Columns Concept`} description="Three-column responsive layout for suburb landers">
  <main class="columnsLayout">
    {columns.map((col, index) => (
      <section class={`col col-${index+1}`}>
        <div>
          <p class="kicker">Electrician {suburb}</p>
          <h2>{col.title}</h2>
          <p>{col.text}</p>
          {index === 0 && <a class="btn" href={`/contact?suburb=${slug}`}>Book service</a>}
          {index === 1 && <ul>
            <li>Switchboard upgrade</li>
            <li>Lighting design</li>
            <li>EV charger fit-off</li>
          </ul>}
          {index === 2 && <div class="mediaPlaceholder"></div>}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .columnsLayout { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); min-height:100vh; font-family:"Inter",sans-serif; }
  .col { padding:2rem; border-right:1px solid rgba(0,0,0,.08); }
  .col:last-child { border-right:none; }
  .col-1 { background:#0c0d12; color:#fff; position:sticky; top:0; height:100vh; }
  .col-2 { background:#f3f0e8; }
  .col-3 { background:#fff; }
  .btn { display:inline-block; margin-top:1rem; padding:.8rem 1.4rem; background:#d7b372; color:#120c05; text-decoration:none; border-radius:999px; }
  .mediaPlaceholder { width:100%; height:240px; background:linear-gradient(135deg,#1a1c27,#2d3141); }
  .kicker { text-transform:uppercase; letter-spacing:.2em; font-size:.8rem; color:rgba(255,255,255,.5); }
  @media (max-width:900px) { .col { height:auto; position:static; border-right:none; border-bottom:1px solid rgba(0,0,0,.08); } .col-1 { height:auto; } }
</style>
