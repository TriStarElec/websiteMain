---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Parnell",
  city: "Auckland",
  slug: "parnell",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/parnell",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Parnell balances heritage terraces, luxury apartments, and busy hospitality strips. Our electricians respect both ends of that spectrum: we protect original plaster while adding new circuits, and we work after-hours so retailers and restaurants stay open. When a job involves body corporates or embassy tenants, we provide insurance certificates, H&S plans, and progress photos so approvals are fast. We also coordinate with lift technicians, HVAC teams, and security contractors so shutdowns happen once. Expect clear scopes, fixed pricing, and tidy handovers whether we’re rewiring a Parnell Rise villa, fitting lighting along St Georges Bay Road, or installing EV chargers in a tight basement car park.",
  nearby: ["Newmarket", "Remuera", "Orakei", "Auckland Central", "Grafton"],
  faqs: [
    {
      q: "Can you comply with heritage restrictions?",
      a: "Yes. We pre-plan containment, reuse existing penetrations where possible, and document every change for council or landlords.",
    },
    {
      q: "Do you support commercial tenancies on Parnell Road?",
      a: "Daily. We schedule noisy work before opening, keep staff informed, and leave the tenancy spotless before customers arrive.",
    },
    {
      q: "What about basement EV chargers?",
      a: "We handle load studies, metering, and tidy conduit runs so EV chargers fit even in tight, low-ceiling car parks.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Parnell electricians for heritage homes and commercial strips — careful installs, after-hours options, and full documentation.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central Auckland • Heritage + Commercial</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Rewires + switchboards for tiled-roof villas</li>
            <li>Lighting + power for gallery and retail spaces</li>
            <li>EV charger installs inside shared basements</li>
            <li>Fault response for hospitality and offices</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
