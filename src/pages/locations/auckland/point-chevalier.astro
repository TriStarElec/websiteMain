---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Point Chevalier",
  city: "Auckland",
  slug: "point-chevalier",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/point-chevalier",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Point Chevalier homeowners expect tidy trades who understand coastal conditions. We keep villas near Coyle Park, family homes around Meola Road, and new builds along the peninsula all running smoothly. Salt air, tight streets, and shared driveways mean planning matters — we route cable neatly, specify marine-grade fittings, and clean up before we leave. Our electricians install EV chargers on sloped driveways, add pool and spa power, and upgrade switchboards before renovations. When storms hit, we respond quickly to nuisance tripping and corroded outlets so your home is back online fast.",
  nearby: ["Westmere", "Herne Bay", "Avondale", "Waterview", "Morningside"],
  faqs: [
    {
      q: "Do you protect installs from salt air?",
      a: "Yes. We use marine-rated fittings, seal penetrations, and schedule maintenance where needed.",
    },
    {
      q: "Can you work with landscapers on waterfront sections?",
      a: "We coordinate trenching, lighting, and pump feeds so everything is installed before decking or concrete goes down.",
    },
    {
      q: "How fast can you attend an outage?",
      a: "Send switchboard photos — we hold priority slots for Point Chev and usually attend within 24–48 hours for urgent fixes.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Point Chevalier electricians for coastal villas and new builds — corrosion-proof installs, EV chargers, and rapid call-outs.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Inner West • Coastal Homes</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard + mains upgrades before renovations</li>
            <li>Pool, spa, and outdoor lighting installs</li>
            <li>EV chargers with load management</li>
            <li>Salt-related fault diagnosis</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
