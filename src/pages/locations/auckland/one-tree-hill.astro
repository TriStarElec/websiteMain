---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "One Tree Hill",
  city: "Auckland",
  slug: "one-tree-hill",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/one-tree-hill",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Homes around One Tree Hill expect tidy trades who respect heritage detailing and busy family schedules. We look after villas bordering Cornwall Park, modern rebuilds, and small commercial sites along Manukau Road. Our electricians protect polished floors, plan containment before drilling, and keep noise low for remote workers. We can stage rewires over several visits so you keep living on-site, and we document every circuit with photos for future reference. Whether you need EV chargers, spa power, or switchboard upgrades before a renovation, we’ll coordinate with builders and landscapers so the project moves without surprises.",
  nearby: ["Royal Oak", "Onehunga", "Epsom", "Ellerslie", "Greenlane"],
  faqs: [
    {
      q: "Can you work during school hours only?",
      a: "Yes. We schedule noisy work while kids are out, and we clean up before the afternoon rush.",
    },
    {
      q: "Do you handle heritage compliance?",
      a: "We plan containment carefully, reuse penetrations where possible, and issue certificates ready for council or insurance.",
    },
    {
      q: "What about coordinating with landscapers?",
      a: "We align trenching, lighting, and pool power with your landscaper so everything goes in before paving or decking.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "One Tree Hill electricians for villas and rebuilds — respectful trades, staged rewires, and fully documented upgrades.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central South • Villas & Family Homes</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard + mains upgrades before renovations</li>
            <li>Outdoor + pool power around Cornwall Park</li>
            <li>EV chargers for shared driveways</li>
            <li>Staged rewires for occupied villas</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
