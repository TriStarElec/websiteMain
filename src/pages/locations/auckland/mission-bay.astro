---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "Mission Bay",
  city: "Auckland",
  slug: "mission-bay",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/mission-bay",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Mission Bay homes face salt spray, entertainment deadlines, and cramped driveway access — so electrical work has to be planned and tidy. We look after beachfront apartments, Tamaki Drive villas, and hillside rebuilds, lining up scaffolds, landscapers, and pool crews so everyone stays on schedule. Our electricians protect polished floors, pre-label cabling for future upgrades, and keep noise low when families are working from home. Whether we’re fault-finding a tripping spa circuit, adding lighting to a roof terrace, or installing dual EV chargers, you get clear communication, photo updates, and compliance documents ready for insurers. We understand council event calendars and can schedule around summer hospitality rushes so your power stays reliable when the crowds arrive.",
  nearby: ["Kohimarama", "St Heliers", "Orakei", "Meadowbank", "Glendowie"],
  faqs: [
    {
      q: "Can you work around Tamaki Drive traffic?",
      a: "Yes. We plan deliveries early, secure parking permits where needed, and keep neighbours notified so disruption stays minimal.",
    },
    {
      q: "Do you offer coastal corrosion solutions?",
      a: "We specify marine-rated fittings, stainless fixings, and gel-filled terminations to keep outdoor power reliable beside the water.",
    },
    {
      q: "How fast can you handle an urgent outage?",
      a: "Send switchboard photos and details — we hold priority slots for Mission Bay and aim to attend within 24–48 hours for urgent issues.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Mission Bay electricians for coastal homes, apartments, and hospitality — tidy installs, corrosion control, and fast communication.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Eastern Bays • Coastal Specialists</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard upgrades before kitchen or pool projects</li>
            <li>Outdoor and roof-terrace lighting</li>
            <li>Dual EV chargers and load management</li>
            <li>Fault finding for salt-affected circuits</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
