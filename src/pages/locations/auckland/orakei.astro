---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Ōrākei",
  city: "Auckland",
  slug: "orakei",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/orakei",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Ōrākei spans cliff-top architecturals, classic 60s homes, and embassy-style estates. Power demand is growing fast — EV chargers, lifts, wine rooms, and fully automated lighting are now standard. We design and deliver electrical upgrades that respect the architecture while meeting today’s load requirements. Before arriving we confirm crane or driveway access, liaise with security teams, and pre-stage switchboard gear so outages stay short. Our work covers everything from new mains for rebuilds overlooking Hobson Bay to outdoor audio, pool lighting, and seawall pumps. Every visit ends with clear notes, compliance certificates, and guidance on future maintenance, so you’re never guessing.",
  nearby: ["Mission Bay", "Kohimarama", "Remuera", "Meadowbank", "St Heliers"],
  faqs: [
    {
      q: "Can you integrate with existing automation systems?",
      a: "Yes. We work with KNX, Control4, and other automation partners to add circuits, sensors, or feature lighting without breaking existing programming.",
    },
    {
      q: "Do you manage Vector coordination for mains upgrades?",
      a: "We handle permits, isolation requests, and inspections so you only deal with one point of contact.",
    },
    {
      q: "Is weekend work possible for hosted events?",
      a: "We book weekend or late-night slots when you’re entertaining so the property stays guest-ready.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Ōrākei electricians for luxury homes and rebuilds — mains upgrades, automation, EV charging, and coastal protection.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Eastern Bays • Luxury Projects</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Mains + switchboard upgrades for rebuilds</li>
            <li>Automation-ready lighting + blind circuits</li>
            <li>EV charger clusters with load management</li>
            <li>Pool, spa, and seawall pump feeds</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
