---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "Meadowbank",
  city: "Auckland",
  slug: "meadowbank",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/meadowbank",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Meadowbank mixes family homes, new townhouses, and hillside rebuilds overlooking the basin. We help owners stay ahead of upgrades: new switchboards before kitchen renos, EV chargers for double garages, and tidy rewires for original 60s layouts. Our team coordinates with builders on subdivision infills, sets up temporary supplies, and documents every circuit so council inspections are painless. When you log a fault, we’ll ask for photos, isolate the circuit safely, and book the first available window — often within a day or two. Expect boot covers, vacuumed work areas, and clear notes so you know exactly what was done and what’s next.",
  nearby: ["Stonefields", "St Johns", "Remuera", "Orakei", "Mission Bay"],
  faqs: [
    {
      q: "Do you work with renovation builders in Meadowbank?",
      a: "Weekly. We schedule rough-in, pre-line, and fit-off stages so plastering and painting stay on track.",
    },
    {
      q: "Can you add outdoor lighting for sloped sections?",
      a: "Yes. We design low-glare lighting with safe access routes and weather-rated fittings for retaining walls or boardwalks.",
    },
    {
      q: "What about EV chargers in duplex driveways?",
      a: "We run shared trenching, add load control, and meter splitting if required so both households stay compliant.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Reliable electricians for Meadowbank families — renovations, EV chargers, outdoor lighting, and fast diagnostics.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central East • Family Homes</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard + RCD upgrades for additions</li>
            <li>Outdoor lighting + power on tiered gardens</li>
            <li>EV charger installs for duplex driveways</li>
            <li>Fault finding before property sales</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
