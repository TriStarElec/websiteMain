---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "St Heliers",
  city: "Auckland",
  slug: "st-heliers",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/st-heliers",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "St Heliers combines cliff-side architecturals with original bungalows near the waterfront. Salt air, steep driveways, and premium finishes mean every electrical job needs planning and protection. We coordinate with builders and landscapers on Tamaki Drive rebuilds, run new mains for basement gyms, and keep beach road hospitality humming with tidy maintenance. When you call, we ask for access notes, photos, and timelines so we can turn up with exactly what’s required. Expect respectful tradespeople, daily updates, and detailed certification ready for council or insurers. Whether you’re adding pool lighting above Ladies Bay or upgrading a kitchen along Maskell Street, we keep the job clean, documented, and on time.",
  nearby: ["Mission Bay", "Glendowie", "Kohimarama", "Orakei", "St Johns"],
  faqs: [
    {
      q: "Do you help manage salt air corrosion?",
      a: "Yes. We favour marine-rated fittings, gel connectors, and periodic checks so outdoor equipment lasts along Tamaki Drive.",
    },
    {
      q: "Can you coordinate with pool installers?",
      a: "We stage conduits, bonding, and switchboard upgrades around pool builders so commissioning happens once.",
    },
    {
      q: "What’s the lead time for St Heliers jobs?",
      a: "Standard bookings are 1–2 weeks out, but urgent outages or settlement-critical repairs are slotted sooner where possible.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Electrical specialists for St Heliers villas and new builds — neat installs, coastal protection, and proactive communication.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Eastern Bays • Residential Experts</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard upgrades before interior renovations</li>
            <li>Landscape + pool lighting for coastal properties</li>
            <li>Dedicated circuits for gyms, saunas, and EVs</li>
            <li>Fault finding when salt causes nuisance tripping</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
