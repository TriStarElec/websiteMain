---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "Takapuna",
  city: "Auckland",
  slug: "takapuna",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/takapuna",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Takapuna mixes cliff-top homes, busy hospitality strips, and tightly scheduled commercial tenancies. We manage electrical work across it all — arranging isolation windows with Vector, protecting designer interiors, and keeping noise down for neighbours working from home. Our crew handles fast troubleshooting when a switchboard in a lakeside villa is tripping every hour, and we plan longer upgrades like EV charger clusters or restaurant fit-outs so the job runs to the minute. Expect respectful tradespeople, photo documentation of the work completed, and full certification you can forward to insurers or landlords. We tidy as we go, communicate clearly, and stay available after handover if anything needs tuning.",
  nearby: ["Milford", "Hauraki", "Devonport", "Forrest Hill", "Belmont"],
  faqs: [
    {
      q: "Can you work overnight so my shop on Hurstmere Road stays open?",
      a: "Yes. We regularly book after-hours slots, stage noise-heavy work early, and leave the tenancy spotless before doors open.",
    },
    {
      q: "Do you install chargers in shared basement car parks?",
      a: "We handle load calculations, coordinate metering changes, and mount chargers neatly so vehicles can still manoeuvre in tight bays.",
    },
    {
      q: "How quickly can you respond to a lake-front fault?",
      a: "Send photos of the switchboard or affected circuit. We hold priority slots for urgent North Shore call-outs and usually attend within 48 hours.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description =
  "Premium electricians for Takapuna homes, apartments, and hospitality — tidy installs, rapid call-outs, and detailed documentation.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">North Shore • Residential & Commercial</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard upgrades before coastal reclads</li>
            <li>Lighting + control refreshes for cafes and apartments</li>
            <li>EV chargers for multi-dwelling car parks</li>
            <li>Outdoor power and pool feeds around Lake Pupuke</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.5rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.15em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; color:#000; background:#fff; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.06); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.1); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
