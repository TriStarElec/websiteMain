---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  slug: "electrician-remuera",
  city: "Auckland",
  suburb: "Remuera",
  region: "Auckland",
  country: "New Zealand",
  brand: "Tri Star Electrical",
  phone: "09 000 0000",
  email: "hello@tristarelectrical.co.nz",
  primaryService: "Residential Electrician",
  serviceLabel: "Electrician",
  siteName: "Tri Star Electrical",
  siteUrl: "https://tristarelectrical.co.nz",
  canonicalPath: "/locations/electrician-remuera",
  ogImage: "/images/og/locations-remuera.jpg",
  heroImage: "/images/heroes/residential-hero.jpg",
  mapQuery: "Remuera, Auckland, New Zealand",
  serviceArea: [
    "Remuera",
    "Newmarket",
    "Epsom",
    "Greenlane",
    "Orakei",
    "Parnell",
    "Ellerslie",
    "Meadowbank",
    "St Johns",
    "Mission Bay",
  ],
  nearbyLinks: [
    { name: "Epsom", href: "/locations/electrician-epsom" },
    { name: "Newmarket", href: "/locations/electrician-newmarket" },
    { name: "Parnell", href: "/locations/electrician-parnell" },
    { name: "Orakei", href: "/locations/electrician-orakei" },
    { name: "Greenlane", href: "/locations/electrician-greenlane" },
  ],
};

const title = `Electrician ${page.suburb} — ${page.brand}`;
const description =
  `Need an electrician in ${page.suburb}, ${page.city}? ` +
  `${page.brand} provides neat, compliant residential electrical work: fault finding, switchboards, lighting, powerpoints, EV chargers, heat pumps, and renovations.`;

const canonicalUrl = new URL(page.canonicalPath, page.siteUrl).toString();

const faqs = [
  {
    q: `Do you service all of ${page.suburb}?`,
    a: `Yes — we cover ${page.suburb} and nearby suburbs. If you're close, book anyway and we’ll confirm.`,
  },
  {
    q: "Can you handle electrical work for renovations and kitchens?",
    a: "Yes. We can plan circuits, add power and lighting, coordinate with other trades, and complete testing and certification.",
  },
  {
    q: "Do you do switchboard upgrades?",
    a: "Yes. If your switchboard is dated, overloaded, or you’re adding high-load equipment, we can upgrade it and bring protection up to modern standards.",
  },
  {
    q: "Can you install EV chargers and outdoor power?",
    a: "Yes. We can install EV chargers, outdoor sockets, garden lighting, and weather-rated equipment with appropriate circuit protection.",
  },
  {
    q: "How do I get a quote?",
    a: "Use the contact form with photos where possible. For larger work, we’ll arrange a site visit and provide a clear scope and price.",
  },
];

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: page.siteUrl + "/" },
    { "@type": "ListItem", position: 2, name: "Locations", item: page.siteUrl + "/locations" },
    { "@type": "ListItem", position: 3, name: `Electrician ${page.suburb}`, item: canonicalUrl },
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: page.brand,
  url: page.siteUrl,
  telephone: page.phone,
  email: page.email,
  areaServed: [{ "@type": "City", name: page.city }, ...page.serviceArea.map((s) => ({ "@type": "Place", name: s }))],
  address: {
    "@type": "PostalAddress",
    addressLocality: page.city,
    addressRegion: page.region,
    addressCountry: page.country,
  },
  makesOffer: [
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Fault finding & repairs" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Switchboard upgrades" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Lighting installation" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Powerpoints & circuits" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "EV charger installation" } },
    { "@type": "Offer", itemOffered: { "@type": "Service", name: "Renovation electrical" } },
  ],
};

const jsonLd = [breadcrumbJsonLd, localBusinessJsonLd, faqJsonLd];
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <main class="page">
    <header class="hero" style={`--hero:url('${page.heroImage}')`}>
      <div class="hero__overlay"></div>
      <div class="wrap hero__inner">
        <p class="eyebrow">Residential • {page.city}</p>
        <h1 class="h1">Electrician {page.suburb}</h1>
        <p class="sub">
          Neat, compliant electrical work for homes in {page.suburb}: fault finding, switchboards, lighting, power, EV chargers, and renovations.
        </p>

        <div class="ctaRow">
          <a class="btn btn--solid" href="/contact#form">Get a Quote</a>
          <a class="btn" href="tel:{page.phone.replace(/\s/g,'')}">Call {page.phone}</a>
        </div>

        <ul class="trust">
          <li>Clear scope & communication</li>
          <li>Clean workmanship</li>
          <li>Tested & documented</li>
        </ul>
      </div>
    </header>

    <section class="wrap section">
      <div class="grid2">
        <div>
          <h2 class="h2">Local electrician in {page.suburb}</h2>
          <p class="p">
            If you want electrical work done properly — without shortcuts — {page.brand} can help.
            We work across owner-occupied homes, rentals, and renovation projects throughout {page.suburb} and nearby suburbs.
          </p>

          <div class="callout">
            <h3 class="h3">Common call-outs in {page.suburb}</h3>
            <ul class="list">
              <li>Fault finding (tripping circuits, dead outlets, flickering lights)</li>
              <li>Switchboard and protection upgrades</li>
              <li>Lighting installs and upgrades (indoor, outdoor, security)</li>
              <li>New powerpoints, dedicated circuits, kitchen / laundry upgrades</li>
              <li>Heat pump, spa, induction hob, and high-load circuits</li>
              <li>EV charger installs and load management</li>
            </ul>
          </div>
        </div>

        <aside class="card">
          <h3 class="h3">Book an electrician</h3>
          <p class="p small">
            For faster quoting, include photos of the switchboard, the affected area, and any labels/brands.
          </p>
          <div class="stack">
            <a class="btn btn--solid" href="/contact#form">Request a Quote</a>
            <a class="btn" href="/services">View Services</a>
          </div>

          <div class="divider"></div>

          <h4 class="h4">Service area</h4>
          <p class="p small">
            {page.serviceArea.join(" • ")}
          </p>
        </aside>
      </div>
    </section>

    <section class="wrap section section--muted">
      <h2 class="h2">What you get</h2>
      <div class="tiles">
        <div class="tile">
          <h3 class="h3">Proper diagnosis</h3>
          <p class="p">We start with testing and clear reasoning — not guesswork — so faults get fixed, not masked.</p>
        </div>
        <div class="tile">
          <h3 class="h3">Workmanship you can trust</h3>
          <p class="p">Neat installs, tidy cable management, appropriate protection, and a clean finish.</p>
        </div>
        <div class="tile">
          <h3 class="h3">Compliance & documentation</h3>
          <p class="p">Testing and the right paperwork for the job, so your home stays safe and insurable.</p>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="grid2">
        <div>
          <h2 class="h2">Popular residential services</h2>
          <ul class="list">
            <li><a class="link" href="/services#fault-finding">Fault finding & repairs</a></li>
            <li><a class="link" href="/services#switchboards">Switchboards & RCD/RCBO upgrades</a></li>
            <li><a class="link" href="/services#lighting">Lighting (LED, feature, outdoor)</a></li>
            <li><a class="link" href="/services#power">Powerpoints, circuits, appliances</a></li>
            <li><a class="link" href="/services#ev-chargers">EV chargers</a></li>
            <li><a class="link" href="/services#renovations">Renovations & new wiring</a></li>
          </ul>

          <div class="note">
            <strong>Tip:</strong> If your power is tripping, don’t keep resetting it — that’s a sign something needs attention.
          </div>
        </div>

        <div class="card">
          <h3 class="h3">Get a fast, accurate quote</h3>
          <ol class="steps">
            <li>Tell us what you need (or what’s going wrong).</li>
            <li>Upload photos if you can (switchboard + area).</li>
            <li>We’ll confirm scope, timing, and pricing.</li>
          </ol>
          <div class="stack">
            <a class="btn btn--solid" href="/contact#form">Start Quote</a>
            <a class="btn" href="mailto:{page.email}">Email {page.email}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap section section--muted">
      <div class="grid2">
        <div>
          <h2 class="h2">Frequently asked questions</h2>
          <div class="faq">
            {faqs.map((f) => (
              <details class="faqItem">
                <summary>{f.q}</summary>
                <p class="p">{f.a}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="card">
          <h3 class="h3">Other nearby areas</h3>
          <ul class="list">
            {page.nearbyLinks.map((l) => (
              <li><a class="link" href={l.href}>Electrician {l.name}</a></li>
            ))}
          </ul>

          <div class="divider"></div>

          <h4 class="h4">Map</h4>
          <div class="map">
            <iframe
              title={`Map of ${page.suburb}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps?q=${encodeURIComponent(page.mapQuery)}&output=embed`}
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap section finalCta">
      <div class="finalCta__inner">
        <h2 class="h2">Need an electrician in {page.suburb}?</h2>
        <p class="p">Tell us what you’re doing (or what’s gone wrong) and we’ll get you sorted.</p>
        <div class="ctaRow">
          <a class="btn btn--solid" href="/contact#form">Request a Quote</a>
          <a class="btn" href="/pricing">Pricing</a>
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </main>
</BaseLayout>

<style>
  .page { background: var(--bg, #fff); color: var(--fg, #000); }
  .wrap { width: min(1120px, calc(100% - 2rem)); margin-inline: auto; }

  .hero {
    position: relative;
    min-height: 70svh;
    display: grid;
    place-items: center;
    background: var(--bg, #000);
    background-image: var(--hero);
    background-size: cover;
    background-position: center;
  }
  .hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,.62), rgba(0,0,0,.28));
  }
  .hero__inner { position: relative; padding: 5.2rem 0 4.2rem; color: #fff; }
  .eyebrow { letter-spacing: .08em; text-transform: uppercase; opacity: .9; font-weight: 700; margin: 0 0 .9rem; }
  .h1 { font-size: clamp(2.1rem, 4vw, 3.2rem); line-height: 1.05; margin: 0 0 1rem; }
  .sub { font-size: 1.15rem; max-width: 58ch; opacity: .95; margin: 0 0 1.6rem; }

  .ctaRow { display: flex; gap: .9rem; flex-wrap: wrap; margin: 0 0 1.2rem; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: .95rem 1.25rem;
    border-radius: 999px;
    border: 1px solid currentColor;
    text-decoration: none;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    font-size: 1.02rem;
    color: inherit;
    background: transparent;
  }
  .btn--solid { background: #000; color: #fff; border-color: #000; }
  .trust { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; gap: 1rem; flex-wrap: wrap; }
  .trust li { background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); padding: .55rem .75rem; border-radius: 999px; font-weight: 650; }

  .section { padding: 3.4rem 0; }
  .section--muted { background: rgba(0,0,0,.035); border-top: 1px solid rgba(0,0,0,.06); border-bottom: 1px solid rgba(0,0,0,.06); }
  .h2 { font-size: clamp(1.5rem, 2.6vw, 2.05rem); margin: 0 0 1rem; }
  .h3 { font-size: 1.2rem; margin: 0 0 .7rem; }
  .h4 { font-size: 1rem; margin: 0 0 .6rem; text-transform: uppercase; letter-spacing: .08em; opacity: .8; }
  .p { margin: 0 0 1rem; max-width: 70ch; color: rgba(0,0,0,.78); }
  .small { font-size: .95rem; }
  .grid2 { display: grid; grid-template-columns: 1.35fr .95fr; gap: 1.6rem; align-items: start; }
  @media (max-width: 860px) { .grid2 { grid-template-columns: 1fr; } .hero__inner{padding: 4.2rem 0 3.2rem;} }

  .card {
    background: #fff;
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 20px;
    padding: 1.25rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
  }
  .stack { display: grid; gap: .7rem; }
  .divider { height: 1px; background: rgba(0,0,0,.08); margin: 1rem 0; }

  .list { margin: 0; padding-left: 1.1rem; color: rgba(0,0,0,.78); }
  .list li { margin: .45rem 0; }

  .callout {
    margin-top: 1.2rem;
    background: rgba(0,0,0,.03);
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 18px;
    padding: 1.1rem;
  }

  .tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 860px) { .tiles { grid-template-columns: 1fr; } }
  .tile {
    background: #fff;
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 18px;
    padding: 1.1rem;
    box-shadow: 0 10px 30px rgba(0,0,0,.05);
  }

  .note {
    margin-top: 1rem;
    padding: .9rem 1rem;
    border-left: 4px solid rgba(0,0,0,.35);
    background: rgba(0,0,0,.03);
    border-radius: 12px;
    color: rgba(0,0,0,.78);
  }

  .steps { margin: 0 0 1.1rem; padding-left: 1.1rem; color: rgba(0,0,0,.78); }
  .steps li { margin: .55rem 0; }

  .faq { display: grid; gap: .7rem; }
  .faqItem {
    border: 1px solid rgba(0,0,0,.08);
    border-radius: 16px;
    padding: .85rem 1rem;
    background: #fff;
  }
  .faqItem summary { cursor: pointer; font-weight: 800; }
  .faqItem p { margin: .7rem 0 0; }

  .link { color: inherit; text-decoration: underline; text-underline-offset: .2em; }

  .map { aspect-ratio: 16/11; border-radius: 16px; overflow: hidden; border: 1px solid rgba(0,0,0,.08); }
  .map iframe { width: 100%; height: 100%; border: 0; }

  .finalCta__inner {
    background: #000;
    color: #fff;
    border-radius: 26px;
    padding: 1.6rem;
    border: 1px solid rgba(0,0,0,.2);
    box-shadow: 0 22px 70px rgba(0,0,0,.18);
  }
  .finalCta__inner .p { color: rgba(255,255,255,.88); }
</style>