---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = "New Lynn";
const slug = "new-lynn";
const mapQuery = `${suburb}, Auckland, New Zealand`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;

const serviceOrder = Astro.props?.serviceOrder
  ?? (Astro.props?.industrialFirst ? ["industrial", "commercial", "residential"] : ["residential", "commercial", "industrial"]);

const services = {
  residential: {
    title: "Residential electrician",
    intro: "Split-load switchboards, tidy lighting plans, EV chargers, and fault response for New Lynn homes.",
    bullets: [
      "Switchboard + protection upgrades",
      "Lighting + power for renovations",
      "EV charger installs + load control",
      "Urgent fault finding + repairs",
    ],
    image: "/images/locations/new-lynn/gallery-1.png",
  },
  commercial: {
    title: "Commercial electrician",
    intro: "After-hours tenancy fit-outs, LynnMall retail maintenance, and clear documentation for landlords.",
    bullets: [
      "Retail + hospitality call-outs",
      "Lighting + POS power reconfigs",
      "Maintenance plans for offices",
      "Emergency response windows",
    ],
    image: "/images/locations/new-lynn/gallery-2.png",
  },
  industrial: {
    title: "Industrial electrician",
    intro: "Workshops along Portage Road rely on fast diagnostics, compliant distribution, and tidy reporting.",
    bullets: [
      "Machine feeds + distribution",
      "Preventative maintenance",
      "Three-phase upgrades",
      "Compliance + RAMS packs",
    ],
    image: "/images/locations/new-lynn/gallery-3.png",
  },
};

const highlights = [
  { title: "Fixed-scope quotes", body: "No surprises. We confirm scope before stepping on site." },
  { title: "Form-first contact", body: "Send everything through the form so we can call back prepared." },
  { title: "Nearby coverage", body: "Kelston • Blockhouse Bay • Titirangi • Glen Eden" },
];

const gallery = [
  { src: "/images/locations/new-lynn/gallery-1.png", caption: "Switchboard tidy-up", detail: "Load-balanced board + relabel" },
  { src: "/images/locations/new-lynn/gallery-2.png", caption: "Retail lighting", detail: "After-hours LynnMall upgrade" },
  { src: "/images/locations/new-lynn/gallery-3.png", caption: "Workshop feed", detail: "Portage Rd machine install" },
];

const recentJobs = (Astro.props?.jobs ?? []).slice(0, 3);
---

<BaseLayout title={`Electrician ${suburb} — Tri Star Electrical`} description="Premium suburb landing page structure">
  <main class="suburbLayout">
    <section class="hero">
      <div class="hero__image" aria-hidden="true"></div>
      <div class="hero__content">
        <p class="kicker">Electrician {suburb}</p>
        <h1>Electrical work done properly in {suburb}</h1>
        <p>Fixed-scope quoting, tidy workmanship, and clear documentation for every job — residential, commercial, and industrial.</p>
        <div class="ctaRow">
          <a class="btn" href={`/contact?suburb=${slug}`}>Request a call</a>
          <a class="link" href={`/locations/auckland/${slug}`}>Full suburb coverage →</a>
        </div>
      </div>
      <div class="hero__map">
        <iframe
          title={`Map of ${suburb}`}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>

    <section class="highlights">
      {highlights.map((highlight) => (
        <article>
          <h2>{highlight.title}</h2>
          <p>{highlight.body}</p>
        </article>
      ))}
    </section>

    <section class="galleryStrip">
      {gallery.map((shot) => (
        <figure>
          <img src={shot.src} alt={shot.caption} loading="lazy" />
          <figcaption>
            <strong>{shot.caption}</strong>
            <span>{shot.detail}</span>
          </figcaption>
        </figure>
      ))}
    </section>

    {serviceOrder.map((key) => (
      <section class="serviceSection" id={key}>
        <div class="serviceSection__copy">
          <p class="kicker">{services[key].title}</p>
          <h2>For {suburb} {services[key].title.toLowerCase()}</h2>
          <p>{services[key].intro}</p>
          <ul>
            {services[key].bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="btn" href={`/contact?suburb=${slug}&service=${key}`}>Book {services[key].title.toLowerCase()}</a>
        </div>
        <div class="serviceSection__media">
          <img src={services[key].image} alt={services[key].title} loading="lazy" />
        </div>
      </section>
    ))}

    <section class="proof is-hidden">
      <h2>Proof + reviews</h2>
      <p>Replace this placeholder with genuine testimonials once collected.</p>
    </section>

    <section class="faq">
      <h2>FAQs for {suburb}</h2>
      <div class="faq__list">
        <details>
          <summary>Do you book after-hours work?</summary>
          <p>Yes. We keep evening slots for LynnMall retailers and workshops that can’t stop during the day.</p>
        </details>
        <details>
          <summary>How do we request a quote?</summary>
          <p>Use the contact form with photos. We’ll review, call you back, and lock in a time.</p>
        </details>
        <details>
          <summary>Do you cover nearby suburbs?</summary>
          <p>Kelston, Blockhouse Bay, Titirangi, Glen Eden — plus wider West Auckland on request.</p>
        </details>
      </div>
    </section>

    <section class="ctaPanel">
      <div>
        <h2>Need an electrician in {suburb}?</h2>
        <p>Send the details through the form — we’ll phone you with a plan.</p>
      </div>
      <a class="btn" href={`/contact?suburb=${slug}`}>Request a call</a>
    </section>
  </main>
</BaseLayout>

<style>
  .suburbLayout { background:#04050c; color:#f7f4ec; font-family:"Inter",sans-serif; }
  .kicker { letter-spacing:.35em; text-transform:uppercase; color:rgba(255,255,255,.6); font-size:.8rem; }
  .hero { position:relative; display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:2rem; padding:3rem 2rem; align-items:center; overflow:hidden; }
  .hero__image { position:absolute; inset:0; background-image:url('/images/locations/new-lynn-hero.jpg'); background-size:cover; background-position:center; opacity:.35; filter:saturate(1.2); }
  .hero__content, .hero__map { position:relative; z-index:1; }
  .hero__content { display:flex; flex-direction:column; gap:1.2rem; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; }
  .btn { padding:.9rem 1.6rem; border-radius:999px; text-decoration:none; font-weight:700; letter-spacing:.08em; text-transform:uppercase; border:1px solid transparent; background:#d6b370; color:#120c05; }
  .link { color:#fff; text-decoration:underline; }
  .hero__map iframe { width:100%; aspect-ratio:4/3; border:1px solid rgba(255,255,255,.2); border-radius:18px; background:#000; }

  .highlights { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; padding:2rem; }
  .highlights article { border:1px solid rgba(255,255,255,.2); padding:1.4rem; backdrop-filter:blur(10px); background:rgba(15,17,23,.6); }

  .galleryStrip { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1rem; padding:0 2rem 2rem; }
  .galleryStrip figure { margin:0; border:1px solid rgba(255,255,255,.15); background:#0c0d15; border-radius:18px; overflow:hidden; }
  .galleryStrip img { width:100%; height:180px; object-fit:cover; display:block; }
  .galleryStrip figcaption { padding:1rem; display:flex; flex-direction:column; gap:.2rem; }
  .galleryStrip strong { font-size:1.05rem; }
  .galleryStrip span { color:rgba(255,255,255,.7); font-size:.9rem; }

  .serviceSection { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1.5rem; padding:2.5rem 2rem; border-top:1px solid rgba(255,255,255,.08); align-items:center; }
  .serviceSection__copy ul { margin:1rem 0 0; padding-left:1.2rem; }
  .serviceSection__media img { width:100%; border-radius:24px; border:1px solid rgba(255,255,255,.2); box-shadow:0 20px 60px rgba(0,0,0,.45); }

  .faq { padding:3rem 2rem; }
  .faq__list { display:grid; gap:1rem; }
  details { border:1px solid rgba(255,255,255,.2); border-radius:12px; padding:1rem; background:rgba(15,17,23,.7); }

  .ctaPanel { padding:2rem; display:flex; justify-content:space-between; align-items:center; gap:1rem; border-top:1px solid rgba(255,255,255,.2); border-bottom:1px solid rgba(255,255,255,.2); }

  .is-hidden { display:none !important; }

  @media (max-width:740px) {
    .galleryStrip img { height:140px; }
    .serviceSection { padding:2rem 1.5rem; }
    .ctaPanel { flex-direction:column; text-align:center; }
  }
</style>
