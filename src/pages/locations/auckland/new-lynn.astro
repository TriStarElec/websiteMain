---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "New Lynn",
  city: "Auckland",
  slug: "new-lynn",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/new-lynn",
  heroImage: "/images/locations/new-lynn-hero.jpg",
  intro:
    "New Lynn mixes apartments around the transport hub, 1950s weatherboards, and light industrial blocks. We support them all: wiring new fit-outs at LynnMall, upgrading switchboards before home renovations, and handling urgent repairs for workshops along Portage Road. Because parking is hectic near the station, we plan access, bring the gear we need on the first visit, and keep communication tight if timings shift. Expect tidy installs, labelled circuits, and compliance docs delivered digitally the same day.",
  nearby: ["Avondale", "Kelston", "Blockhouse Bay", "Titirangi", "Glen Eden"],
  faqs: [
    {
      q: "Do you work around train-station congestion?",
      a: "Yes. We schedule arrivals off-peak, secure parking, and keep neighbours informed if we need driveway access.",
    },
    {
      q: "Can you help with townhouse EV chargers?",
      a: "We assess load, install tidy containment, and add smart control so shared supplies aren’t overloaded.",
    },
    {
      q: "What about retail or hospitality call-outs?",
      a: "We keep after-hours slots so shops and cafes can keep trading with minimal downtime.",
    },
  ],
};

const recentJobs = [
  {
    title: "LynnMall tenancy refresh",
    details: "After-hours lighting + POS power upgrade with zero downtime for the retailer.",
    meta: "2-night change-over • documentation delivered before re-opening",
  },
  {
    title: "Portage Road workshop",
    details: "New three-phase circuits, labelled distribution board, and preventative maintenance schedule.",
    meta: "Industrial • compliant RAMS + photos for insurance",
  },
  {
    title: "Totara Ave apartments",
    details: "Load-balancing EV chargers and surge-protected switchboard upgrade for 12 townhouses.",
    meta: "Residential body corporate • 4-day install",
  },
];

const highlightServices = [
  {
    title: "Retail + hospitality",
    copy: "After-hours repairs, new tenancies, and split-meter upgrades so stores keep trading on LynnMall’s timetable.",
  },
  {
    title: "Townhouse + apartment upgrades",
    copy: "EV chargers, shared switchboards, and smart load management for modern multi-dwelling sites.",
  },
  {
    title: "Industrial call-outs",
    copy: "Workshops on Portage Road rely on us for distribution, machine feeds, and preventative checks.",
  },
  {
    title: "Home studios + cabins",
    copy: "Compliant submains, RCD protection, and tidy data cabling for the growing number of home businesses.",
  },
];

const quickStats = [
  { label: "Avg lead time", value: "2.1 days", note: "for urgent New Lynn call-outs" },
  { label: "EV-ready installs", value: "32", note: "chargers fitted across LynnMall precinct" },
  { label: "After-hours jobs", value: "18", note: "retail & hospitality last quarter" },
];

const nearbyDetails = [
  { name: "Avondale", slug: "avondale", desc: "Light industry + new apartments" },
  { name: "Kelston", slug: "kelston", desc: "Schools and workshops" },
  { name: "Blockhouse Bay", slug: "blockhouse-bay", desc: "Coastal homes" },
  { name: "Titirangi", slug: "titirangi", desc: "Bush properties" },
  { name: "Glen Eden", slug: "glen-eden", desc: "Rail-side villas" },
];

const styleDirections = [
  {
    name: "Onyx Glass",
    palette: ["#05060a", "#1b1f2f", "#f7f3ed"],
    vibe: "High-gloss black glass, blurred layers, brass micro-accents.",
    usage: "Pair with strong photography + pill buttons.",
  },
  {
    name: "Porcelain Contrast",
    palette: ["#f9f6f0", "#1f1f1f", "#c3a574"],
    vibe: "Soft off-white base, serif headlines, thin black rules.",
    usage: "Great for heavy copy + elegant iconography.",
  },
  {
    name: "Midnight Brass",
    palette: ["#0b0f14", "#2d3139", "#d6b370"],
    vibe: "Deep blue-black gradient, subtle brass dividers, structured layout.",
    usage: "Use when we want more dramatic lighting cues.",
  },
];

const mapEmbed = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d24885.833348771032!2d174.6606!3d-36.9084!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6d0d48ca42f6c9a7%3A0x500ef6143a2e580!2sNew%20Lynn%2C%20Auckland%200600!5e0!3m2!1sen!2snz!4v1730226400000";

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "New Lynn electricians for homes, apartments, and industrial — agile scheduling, neat installs, and compliance-ready reporting.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <div class="heroCard">
          <p class="eyebrow">West Auckland • Transport Hub</p>
          <h1>Electrician {suburb.name}</h1>
          <p class="heroCopy">{suburb.intro}</p>
          <div class="ctaRow">
            <a class="btn" href="/contact#form">Request a quote</a>
          </div>
        </div>
      </div>
    </header>

    <section class="section localProof is-hidden">
      <div class="card recentWork">
        <h2>Recent work in {suburb.name}</h2>
        <ul>
          {recentJobs.map((job) => (
            <li>
              <strong>{job.title}</strong>
              <p>{job.details}</p>
              <span>{job.meta}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card testimonial">
        <h3>What locals say</h3>
        <blockquote>
          “Tri Star handled our LynnMall shop refit overnight. Floor spotless the next morning and the paperwork was in my inbox by 7am.”
        </blockquote>
        <p class="cite">— Retail Manager, Totara Ave</p>
      </div>
    </section>

    <section class="section serviceHighlights">
      <h2>What we’re called for most</h2>
      <div class="serviceGrid premium">
        {highlightServices.map((service) => (
          <article class="serviceCard">
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section statsBand">
      {quickStats.map((stat) => (
        <div class="stat">
          <p class="statValue">{stat.value}</p>
          <p class="statLabel">{stat.label}</p>
          <p class="statNote">{stat.note}</p>
        </div>
      ))}
    </section>

    <section class="section areaAndMap">
      <div>
        <h2>Nearby areas serviced</h2>
        <ul class="nearbyList">
          {nearbyDetails.map((area) => (
            <li>
              <a href={`/locations/auckland/${area.slug}`}>Electrician {area.name}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="mapCard">
        <h3>Where we work</h3>
        <iframe
          title="Map of New Lynn"
          src={mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </section>

    <section class="section ctaBand">
      <div class="ctaInner">
        <div>
          <h2>Need tidy electrical work in {suburb.name}?</h2>
          <p>Share photos, plans, or access notes. We’ll confirm scope, timing, and price — usually within one business day.</p>
        </div>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Book now</a>
        </div>
      </div>
    </section>

    <section class="section styleShowcase">
      <h2>Visual directions to evaluate</h2>
      <div class="styleGrid">
        {styleDirections.map((style) => (
          <article>
            <div class="styleHeader">
              <h3>{style.name}</h3>
              <p>{style.vibe}</p>
            </div>
            <div class="swatches">
              {style.palette.map((color) => (
                <span style={`--swatch-color:${color}`}></span>
              ))}
            </div>
            <p class="styleUsage">{style.usage}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";

  .location { background:#f8f7f4; color:#0c0d0f; }
  .hero { position:relative; padding:4.5rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:linear-gradient(120deg,rgba(1,3,6,.85),rgba(3,7,14,.35)); backdrop-filter: blur(2px); }
  .hero__inner { position:relative; width:min(1100px,90%); margin:0 auto; display:flex; justify-content:flex-start; }
  .heroCard {
    background: rgba(7,10,18,.55);
    border: 1px solid rgba(255,255,255,.24);
    border-radius: 32px;
    padding: clamp(1.75rem, 3vw, 2.75rem);
    color: #fff;
    backdrop-filter: blur(22px);
    box-shadow: 0 25px 70px rgba(0,0,0,.35);
    max-width: 760px;
  }
  .heroCard .eyebrow { color: rgba(255,255,255,.78); letter-spacing:.25em; }
  .heroCard h1 { font-size: clamp(2.5rem,5vw,3.6rem); margin:0 0 1rem; }
  .heroCopy { font-size: 1.08rem; line-height: 1.75; color: rgba(255,255,255,.9); margin:0 0 1.25rem; }
  .btn {
    padding:.9rem 1.6rem;
    border-radius:999px;
    border:1px solid transparent;
    background:#f5f1e7;
    color:#0b0d12;
    font-weight:700;
    text-decoration:none;
    letter-spacing:.06em;
    text-transform:uppercase;
  }

  .is-hidden { display:none !important; }

  .serviceHighlights { text-align:center; }
  .serviceGrid.premium { margin-top:1.5rem; display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1.2rem; }
  .serviceCard {
    border:1px solid rgba(15,18,30,.08);
    border-radius:26px;
    padding:1.4rem;
    text-align:left;
    background:#fff;
    box-shadow:0 25px 50px rgba(4,6,9,.08);
  }

  .statsBand {
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:1rem;
    background:linear-gradient(120deg,#050709,#1a1f2c);
    color:#fff;
    border-radius:32px;
    padding:2rem;
  }
  .statValue { font-size:2rem; font-weight:700; margin:0; }
  .statLabel { margin:.2rem 0; letter-spacing:.1em; text-transform:uppercase; font-size:.85rem; }
  .statNote { margin:0; color:rgba(255,255,255,.78); }

  .areaAndMap { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:1.5rem; }
  .nearbyList { list-style:disc; padding-left:1.25rem; display:flex; flex-direction:column; gap:.4rem; font-size:1.05rem; }
  .nearbyList a { color:inherit; text-decoration:none; border-bottom:1px solid rgba(15,18,30,.15); padding-bottom:.2rem; }
  .mapCard { border:1px solid rgba(0,0,0,.12); border-radius:28px; overflow:hidden; background:#fff; box-shadow:0 18px 45px rgba(0,0,0,.1); padding:1rem; }
  .mapCard iframe { width:100%; height:320px; border:0; border-radius:18px; }

  .ctaBand { padding:0; }
  .ctaInner {
    border-radius:32px;
    border:1px solid rgba(0,0,0,.08);
    background:linear-gradient(120deg,#08090d,#1c2130);
    color:#fff;
    padding:2rem;
    display:flex;
    flex-direction:column;
    gap:1rem;
    box-shadow:0 30px 80px rgba(0,0,0,.25);
  }
  .ctaInner p { color:rgba(255,255,255,.78); }

  .styleShowcase { text-align:center; }
  .styleGrid { margin-top:1.5rem; display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; }
  .styleGrid article {
    border:1px solid rgba(15,18,30,.1);
    border-radius:28px;
    padding:1.2rem;
    background:#fff;
    box-shadow:0 20px 40px rgba(12,13,15,.08);
  }
  .styleHeader h3 { margin:.2rem 0; font-size:1.2rem; }
  .styleHeader p { margin:0; color:rgba(12,13,15,.65); font-size:.95rem; }
  .swatches { display:flex; gap:.45rem; margin:1rem 0; }
  .swatches span {
    width:40px; height:40px;
    border-radius:50%;
    border:1px solid rgba(0,0,0,.1);
    background:var(--swatch-color);
  }
  .styleUsage { margin:0; font-size:.95rem; color:rgba(12,13,15,.7); }

  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:16px; padding:1rem; margin-bottom:1rem; background:#fff; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
