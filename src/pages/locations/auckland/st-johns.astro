---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "St Johns",
  city: "Auckland",
  slug: "st-johns",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/st-johns",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "St Johns covers classic brick-and-tile homes, new infill builds, and education facilities near the train line. Electrical jobs here often involve upgrading older switchboards, adding power to studios or granny flats, and integrating EV chargers without overloading existing mains. We also help local schools and health practices schedule maintenance outside class hours, keeping noise low and paperwork ready for board approvals. When you book us we’ll ask for photos, access notes, and time constraints so we can arrive with the right parts and finish in one hit. Expect tidy drop sheets, labelled circuits, and compliance docs delivered digitally the same day.",
  nearby: ["Meadowbank", "Stonefields", "Glen Innes", "Remuera", "Mission Bay"],
  faqs: [
    {
      q: "Do you service rental properties in St Johns?",
      a: "Yes. We organise access with tenants, document issues with photos, and provide clear reports for landlords.",
    },
    {
      q: "Can you add power to backyard studios?",
      a: "We run new submains, install RCD protection, and certify the work so consent sign-off is simple.",
    },
    {
      q: "What about school or clinic maintenance?",
      a: "We schedule around operating hours, provide RAMS paperwork, and keep staff informed before and after each visit.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Dependable electricians for St Johns homes, rentals, and schools — upgrades, EV chargers, and compliant documentation.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central East • Family & Education</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard replacements for older brick homes</li>
            <li>Studio + granny flat submains</li>
            <li>EV charger installs with load control</li>
            <li>Planned maintenance for schools and clinics</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
