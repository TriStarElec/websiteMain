---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = {
  name: "Ellerslie",
  city: "Auckland",
  slug: "ellerslie",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/ellerslie",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Ellerslie combines village shops, character homes, and new developments near the racecourse. Our electricians support all three: we plan upgrades for villa renovations, keep retail tenancies along Main Highway running, and install EV chargers or office circuits in townhouses. Because parking and train crossings can slow work, we schedule arrivals early, bring the right parts first time, and keep communication tight if traffic interferes. Expect neat containment, labelled switchboards, and compliance documents delivered as soon as we pack down. We also help landlords lock in Healthy Homes requirements with fast reports and repairs.",
  nearby: ["Greenlane", "Remuera", "Penrose", "Mt Wellington", "One Tree Hill"],
  faqs: [
    {
      q: "Can you work around race-day closures?",
      a: "Yes. We check event calendars and schedule around major Ellerslie race days to avoid access issues.",
    },
    {
      q: "Do you provide landlord reports?",
      a: "We document issues with photos, estimate repairs, and provide compliance certificates for Healthy Homes records.",
    },
    {
      q: "What about small business call-outs?",
      a: "We keep spare parts in the van for common retail faults and can attend before or after trading hours.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Ellerslie electricians for homes, rentals, and shops — reliable upgrades, prompt repairs, and tidy paperwork.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central East • Homes & Retail</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard + RCD upgrades for villas</li>
            <li>Retail lighting + POS power tweaks</li>
            <li>EV chargers + office circuits for townhouses</li>
            <li>Healthy Homes electrical compliance</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
