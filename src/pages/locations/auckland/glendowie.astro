---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "Glendowie",
  city: "Auckland",
  slug: "glendowie",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/glendowie",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Clifftop views, sea air, and multi-stage renovations make Glendowie electrical work all about planning. We organise access along narrow bays, protect polished floors, and schedule noisy tasks while kids are at school so the household keeps moving. From replacing ageing VIR wiring in 1950s homes to installing EV-ready switchboards in new architecturals, we map every circuit, label clearly, and photograph as-built details. We also coordinate with pool installers and landscapers around Riddell Road and Churchill Park so power, lighting, and control cables are in the ground before concrete or decking goes down. Expect respectful tradespeople, daily updates, and compliance paperwork you can forward to council or insurers without waiting weeks.",
  nearby: ["St Heliers", "Kohimarama", "St Johns", "Meadowbank", "Mission Bay"],
  faqs: [
    {
      q: "Can you protect outdoor gear from salt spray?",
      a: "Yes. We specify marine-grade fittings, gel joints, and scheduled maintenance to keep coastal installs reliable.",
    },
    {
      q: "Do you work with custom builders on clifftop homes?",
      a: "Regularly. We provide staged pricing, coordinate inspections, and keep architects informed with site photos.",
    },
    {
      q: "How quickly can you attend a fault?",
      a: "Send switchboard photos and details — we hold priority slots for Glendowie and aim for 24–48 hour response on urgent jobs.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Glendowie electricians for coastal villas and rebuilds — tidy installs, corrosion control, and detailed documentation.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Eastern Bays • Coastal Projects</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard + mains upgrades for rebuilds</li>
            <li>Landscape + pool lighting overlooking the harbour</li>
            <li>EV charger installs on steep driveways</li>
            <li>Fault finding on salt-affected circuits</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
