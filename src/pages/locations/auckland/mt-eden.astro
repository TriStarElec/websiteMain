---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const suburb = {
  name: "Mt Eden",
  city: "Auckland",
  slug: "mt-eden",
  canonical: "https://tristarelectrical.co.nz/locations/auckland/mt-eden",
  heroImage: "/images/heroes/residential-hero.jpg",
  intro:
    "Mt Eden mixes heritage villas, modern infill homes, and bustling hospitality. Our electricians respect both ends of the spectrum — we cover floors, plan containment to protect detailed plasterwork, and coordinate with café owners or designers so projects stay on schedule. Whether you’re rewiring a villa near the mountain, adding gallery lighting on Dominion Road, or upgrading switchboards for a home office, we deliver tidy installs, labelled circuits, and comprehensive documentation. We also handle EV chargers for shared driveways, spa or sauna circuits, and load upgrades before kitchen renovations. Communication is proactive: you’ll know who’s arriving, what’s happening, and what’s next.",
  nearby: ["Kingsland", "Sandringham", "Eden Terrace", "Epsom", "Three Kings"],
  faqs: [
    {
      q: "Can you work after hours for hospitality?",
      a: "Yes. We book overnight or early-morning slots so restaurants and bars keep trading.",
    },
    {
      q: "Do you stage rewires for occupied villas?",
      a: "We plan zone by zone, protect interiors, and clean up daily so you can stay in the house.",
    },
    {
      q: "What about EV chargers in narrow driveways?",
      a: "We design smart load control, run neat conduit, and keep access clear for multiple vehicles.",
    },
  ],
};

const title = `Electrician ${suburb.name} — Tri Star Electrical`;
const description = "Mt Eden electricians for villas, hospitality, and offices — respectful trades, neat wiring, and detailed documentation.";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://tristarelectrical.co.nz/" },
      { "@type": "ListItem", position: 2, name: "Locations", item: "https://tristarelectrical.co.nz/locations" },
      { "@type": "ListItem", position: 3, name: `Electrician ${suburb.name}`, item: suburb.canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: suburb.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: { "@type": "Answer", text: faq.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} canonical={suburb.canonical} structuredData={structuredData}>
  <main class="location">
    <header class="hero" style={`background-image:url(${suburb.heroImage})`}>
      <div class="scrim"></div>
      <div class="hero__inner">
        <p class="eyebrow">Central Auckland • Villas & Hospitality</p>
        <h1>Electrician {suburb.name}</h1>
        <p>{suburb.intro}</p>
        <div class="ctaRow">
          <a class="btn" href="/contact#form">Request a quote</a>
          <a class="btn btn--ghost" href="/services">View services</a>
        </div>
      </div>
    </header>

    <section class="section">
      <div class="grid">
        <div>
          <h2>Nearby areas served</h2>
          <ul class="pillList">
            {suburb.nearby.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
        <div>
          <h2>Popular call-outs</h2>
          <ul>
            <li>Switchboard upgrades before renovations</li>
            <li>Feature + gallery lighting for hospitality</li>
            <li>EV chargers + outdoor power</li>
            <li>Fault finding for older villas</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section">
      <h2>FAQs</h2>
      <div class="faq">
        {suburb.faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  @import "../../../styles/pages.css";
  .location { background:#fff; color:#111; }
  .hero { position:relative; padding:4rem 0; background-size:cover; background-position:center; }
  .scrim { position:absolute; inset:0; background:rgba(0,0,0,.55); }
  .hero__inner { position:relative; width:min(960px,90%); margin:0 auto; color:#fff; }
  .hero__inner h1 { font-size:clamp(2.4rem,4vw,3.6rem); margin:.4rem 0 1rem; }
  .hero__inner p { font-size:1.05rem; line-height:1.6; }
  .eyebrow { text-transform:uppercase; letter-spacing:.2em; font-weight:600; }
  .ctaRow { display:flex; gap:1rem; flex-wrap:wrap; margin-top:1.5rem; }
  .btn { padding:.85rem 1.4rem; border-radius:999px; border:1px solid currentColor; background:#fff; color:#000; font-weight:700; text-decoration:none; }
  .btn--ghost { background:transparent; color:#fff; border-color:#fff; }
  .section { padding:3rem 0; width:min(960px,90%); margin:0 auto; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:2rem; }
  .pillList { list-style:none; display:flex; flex-wrap:wrap; gap:.6rem; padding:0; }
  .pillList li { padding:.4rem .9rem; border-radius:999px; background:rgba(0,0,0,.08); font-weight:600; }
  .faq details { border:1px solid rgba(0,0,0,.12); border-radius:14px; padding:1rem; margin-bottom:1rem; }
  .faq summary { cursor:pointer; font-weight:700; }
</style>
