---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = Astro.props?.suburb ?? "Sample Suburb";
const slug = Astro.props?.slug ?? "sample-suburb";

const sections = [
  { heading: "Statement", body: `Lead with a confident electrician message for ${suburb}.` },
  { heading: "Grid", body: "List services + coverage with icons." },
  { heading: "Timeline", body: "Explain booking → arrival → completion for suburb leads." },
  { heading: "Footer CTA", body: "Use clear CTA + phone." },
];
---

<BaseLayout title={`Electrician ${suburb} — Sections Concept`} description="Stacked clean sections for suburb landing pages"> 
  <main class="sectionsLayout">
    <section class="statement">
      <p class="kicker">Electrician {suburb}</p>
      <h1>Premium local service</h1>
      <p>Pair a calm headline with a single supporting paragraph. Add real stats later.</p>
    </section>

    <section class="grid">
      {sections.slice(0,2).map((item) => (
        <article>
          <h2>{item.heading}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </section>

    <section class="timeline">
      {sections.slice(2,3).map((item) => (
        <article>
          <h2>{item.heading}</h2>
          <p>{item.body}</p>
        </article>
      ))}
    </section>

    <section class="cta">
      <div>
        <h2>Need an electrician in {suburb}?</h2>
        <p>Swap this placeholder copy with your real CTA.</p>
        <a class="btn" href={`/contact?suburb=${slug}`}>Book now</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .sectionsLayout { background:#faf8f2; color:#0c0d11; font-family:"Helvetica Neue", Arial, sans-serif; }
  .kicker { letter-spacing:.3em; text-transform:uppercase; color:rgba(0,0,0,.6); }
  .statement { padding:4rem 2rem; border-bottom:1px solid rgba(0,0,0,.1); text-align:center; }
  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; padding:3rem 2rem; }
  .grid article { border:1px solid rgba(0,0,0,.08); padding:1.5rem; background:#fff; }
  .timeline { padding:2rem; border-top:1px solid rgba(0,0,0,.1); border-bottom:1px solid rgba(0,0,0,.1); text-align:center; }
  .cta { padding:3rem 2rem; text-align:center; }
  .btn { margin-top:1rem; padding:.8rem 1.4rem; background:#0c0d11; color:#fff; text-decoration:none; border-radius:999px; }
</style>
