---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Layout Tiered",
  description: "Tiered sections stepping downward with angled dividers.",
  tiers: [
    { title: "Hero tier", text: "Angled background slice with offset CTA." },
    { title: "Content tier", text: "Two-column text + media blocks." },
    { title: "CTA tier", text: "Full-width gradient with centered button." },
  ],
};
---

<BaseLayout title={page.title} description={page.description}>
  <main class="tieredLayout">
    <section class="tier tier--hero">
      <div class="tier__inner">
        <img src="/images/logo/g16.png" alt="Tri Star" />
        <h1>Tiered presentation</h1>
        <p>Diagonal section breaks add momentum and keep eyes moving down the page.</p>
        <a class="btn" href="/services">Explore services</a>
      </div>
    </section>

    <section class="tier tier--content">
      <div class="tier__inner">
        {page.tiers.map((tier) => (
          <article>
            <h2>{tier.title}</h2>
            <p>{tier.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="tier tier--cta">
      <div class="tier__inner">
        <h2>Need this structure?</h2>
        <p>Combine angled backgrounds with alternating gradients for any suburb page.</p>
        <a class="btn" href="/contact#form">Start conversation</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tieredLayout { font-family:"Inter",sans-serif; color:#0a0b0f; }
  .tier { position:relative; padding:4rem 0; }
  .tier::after { content:""; position:absolute; left:0; right:0; top:0; height:50px; transform:skewY(-3deg); background:inherit; transform-origin:top left; }
  .tier__inner { width:min(1100px,92%); margin:0 auto; }
  .tier--hero { background:#05060a; color:#f8f7f1; }
  .tier--content { background:#f0ede5; }
  .tier--cta { background:linear-gradient(120deg,#05060a,#1f2435); color:#fff; text-align:center; }
  .tier--content article { padding:1.5rem; border:1px solid rgba(5,6,10,.1); margin-bottom:1rem; background:#fff; }
  .btn { padding:.9rem 1.5rem; border-radius:999px; text-decoration:none; display:inline-flex; align-items:center; justify-content:center; font-weight:700; background:#d5b26c; color:#0a0b0f; }
</style>
