---
import BaseLayout from "../../layouts/BaseLayout.astro";

const suburb = Astro.props?.suburb ?? "Sample Suburb";
const slug = Astro.props?.slug ?? "sample-suburb";

const page = {
  title: `Electrician ${suburb} — Gallery Concept`,
  description: "Masonry grid layout for suburb-focused landing pages heavy on imagery.",
  gallery: [
    { heading: "Projects in suburb", body: `Showcase three recent ${suburb} jobs with before/after tiles.` },
    { heading: "Testimonials", body: "Swap in genuine reviews once collected." },
    { heading: "Service highlights", body: "Use denser cards to explain EV chargers, rewires, inspections." },
    { heading: "Contact", body: `Reiterate response time for ${suburb} and nearby areas.` },
  ],
};
---

<BaseLayout title={page.title} description={page.description}>
  <main class="galleryLayout">
    <header class="floatingNav">
      <img src="/images/logo/g16.png" alt="Tri Star" />
      <nav>
        <a href="#mosaic">Projects</a>
        <a href="#quote">Reviews</a>
        <a href="#spec">Services</a>
        <a href="#media">Coverage</a>
      </nav>
      <a class="btn" href={`/contact?suburb=${slug}`}>Book ${suburb}</a>
    </header>

    <section class="mosaic" id="mosaic">
      <div class="mosaic__item large"></div>
      <div class="mosaic__item">
        <p class="kicker">Electrician {suburb}</p>
        <h1>Project gallery</h1>
        <p>Drop images from switchboard upgrades, lighting installs, and EV chargers completed in {suburb}.</p>
      </div>
      <div class="mosaic__item"></div>
      <div class="mosaic__item wide"></div>
    </section>

    <section class="galleryCards">
      {page.gallery.map((card) => (
        <article>
          <h2>{card.heading}</h2>
          <p>{card.body}</p>
        </article>
      ))}
    </section>

    <section class="stackedQuote" id="quote">
      <p class="glyph">“</p>
      <div>
        <p>Replace this placeholder with a real {suburb} review once available.</p>
        <span>— Future client, {suburb}</span>
      </div>
      <p class="glyph">”</p>
    </section>

    <section class="specList" id="spec">
      <article>
        <h3>Popular in {suburb}</h3>
        <ul>
          <li>Switchboards + rewires</li>
          <li>EV charger installs</li>
          <li>Lighting + heat pumps</li>
        </ul>
      </article>
      <article>
        <h3>Nearby coverage</h3>
        <ul>
          <li><a href={`/locations/auckland/${slug}`}>Primary suburb page</a></li>
          <li><a href="/locations/auckland/remuera">Remuera</a></li>
          <li><a href="/locations/auckland/avondale">Avondale</a></li>
        </ul>
      </article>
    </section>

    <section class="mediaStrip" id="media">
      <div class="stripItem"></div>
      <div class="stripItem"></div>
      <div class="stripItem"></div>
      <div class="stripItem"></div>
    </section>
  </main>
</BaseLayout>

<style>
  .galleryLayout { background:#0c0d11; color:#f5f5f0; font-family:"Sora","Inter",sans-serif; }
  .floatingNav { position:sticky; top:0; display:flex; align-items:center; justify-content:space-between; padding:1rem 2rem; background:rgba(12,13,17,.9); backdrop-filter:blur(12px); z-index:10; }
  .floatingNav img { width:80px; }
  .floatingNav nav { display:flex; gap:1rem; text-transform:uppercase; letter-spacing:.2em; font-size:.85rem; }
  .btn { padding:.7rem 1.4rem; border-radius:999px; background:#f5c16c; color:#0b0c10; text-decoration:none; font-weight:700; }

  .mosaic { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); grid-auto-rows:220px; gap:1rem; padding:2rem; }
  .mosaic__item { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); }
  .mosaic__item.large { grid-row:span 2; background:linear-gradient(135deg,#0f111b,#2a2e3d); }
  .mosaic__item.wide { grid-column:span 2; }
  .kicker { text-transform:uppercase; letter-spacing:.3em; color:rgba(255,255,255,.6); }

  .galleryCards { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; padding:2rem; }
  .galleryCards article { background:#1a1c27; padding:1.4rem; border:1px solid rgba(255,255,255,.08); }

  .stackedQuote { display:flex; align-items:center; justify-content:center; gap:1rem; padding:3rem 2rem; border-top:1px solid rgba(255,255,255,.1); border-bottom:1px solid rgba(255,255,255,.1); }
  .stackedQuote .glyph { font-size:4rem; color:rgba(255,255,255,.2); }

  .specList { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:1rem; padding:2rem; }
  .specList article { border:1px solid rgba(255,255,255,.08); padding:1rem; background:#12131a; }

  .mediaStrip { display:flex; gap:1rem; overflow-x:auto; padding:2rem; }
  .stripItem { flex:0 0 240px; height:180px; background:linear-gradient(135deg,#161720,#2e3143); border:1px solid rgba(255,255,255,.08); }
</style>
