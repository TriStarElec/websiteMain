---
// File: src/pages/services.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages.css";

const SERVICE_HERO_IMG = "/images/services-hero.png";
---

<BaseLayout title="Services — Tri Star Electrical">
  <main class="page">
    <header class="pageHero">
      <div
        class="heroBg"
        style={`background-image:url(${SERVICE_HERO_IMG});`}
        aria-hidden="true"
      ></div>
      <div class="heroScrim" aria-hidden="true"></div>

      <div class="center heroInner">
        <h1 class="h1 heroTitle">Services</h1>
        <p class="h2 heroSub">Industrial • Commercial • Residential — done properly, end-to-end.</p>
        <div class="ctaRow">
          <a class="linkBtn linkBtn--solid" href="/contact#form">Contact Now</a>
        </div>
      </div>
    </header>

    <section class="pageSection" id="services">
      <div class="center">
        <div class="servicesGrid">

          <article class="serviceCard" id="industrial">
            <h2 class="serviceCardTitle">Industrial</h2>
                <ul class="serviceList">
                    <li>Breakdowns, fault finding & repairs</li>
                    <li>Motor control, isolation & safety upgrades</li>
                    <li>PLC/controls support & modifications</li>
                    <li>Machine/plant wiring & troubleshooting</li>
                    <li>Preventative maintenance</li>
                    <li>Switchboards, MCCs & distribution</li>
                    <li>Instrumentation & process wiring</li>
                </ul>
            </article>

            <article class="serviceCard" id="commercial">
                <h2 class="serviceCardTitle">Commercial</h2>
                <ul class="serviceList">
                    <li>Tenant fit-outs & refurbishments</li>
                    <li>Office lighting upgrades (LED conversions)</li>
                    <li>Power, data & communications</li>
                    <li>Emergency & exit lighting</li>
                    <li>Planned maintenance & reactive callouts</li>
                    <li>Switchboards, distribution & load upgrades</li>
                    <li>Compliance checks & reporting</li>
                </ul>
            </article>

            <article class="serviceCard" id="residential">
                <h2 class="serviceCardTitle">Residential</h2>
                <ul class="serviceList">
                    <li>Switchboards & rewires</li>
                    <li>Fault finding & repairs</li>
                    <li>Renovations & additions</li>
                    <li>Lighting (interior/exterior) & feature installs</li>
                    <li>Power points, USB, data, TV</li>
                    <li>Heat pumps, ventilation, bathroom fans</li>
                    <li>EV chargers</li>
                    <li>Smart home wiring & upgrades</li>
                </ul>
                <div class="noteBox">
                    <h3 class="noteTitle">Fixed-cost residential quoting</h3>
                    <p class="noteText">
                      All residential work is quoted at a fixed cost. If anything changes on-site, we’ll clearly
                      explain the variation and get your approval before continuing — so there are no surprises
                      when the invoice lands.
                    </p>
                  </div>
            </article>
        </div>
      </div>
    </section>

    <section class="pageFooterCta">
      <div class="center">
        <h2 class="sectionTitle">Ready to get it sorted?</h2>
        <p class="sectionText">Send the details through and we’ll come back with a clear plan and price.</p>
        <div class="ctaRow">
          <a class="linkBtn" href="/contact#form">Contact Now</a>
        </div>

        <div class="finePrint">
          <a class="linkText" href="/">Home</a>
          <a class="linkText" href="/about">About</a>
          <a class="linkText" href="/contact">Contact</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>