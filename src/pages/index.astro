---
import "../styles/snap.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import SnapSection from "../components/SnapSection.astro";
---
<BaseLayout title="Tri Star Electrical — Auckland">
  <main class="snap" id="snapRoot">
    <!-- Gate -->
    <SnapSection variant="black" id="gate">
      <div class="center">
        <div class="ctaColumn">
          <a class="linkBtn" href=/contact#form>Contact Now</a>
          <a class="linkText" href="#entry">Enter Page</a>
        </div>
      </div>
    </SnapSection>

    <!-- Problem sequence -->
    <SnapSection
      variant="image"
      image="/images/bad-1.png"
      imagePosition="50% 40%"
      imagePositionMobile="62% 35%"
      id="entry"
    >

    </SnapSection>

    <SnapSection
      variant="image"
      image="/images/bad-2.png"
      imagePosition="50% 45%"
      imagePositionMobile="40% 38%"
      id="missed-appointment"
    >

    </SnapSection>

    <SnapSection
      variant="image"
      image="/images/bad-3.png"
      imagePosition="50% 42%"
      imagePositionMobile="58% 36%"
      id="invoice-surprise"
    >

    </SnapSection>

    <!-- Reset text (full-screen white, centered, snapped) -->
    <SnapSection variant="white" id="enough">
      <div class="center">
        <h1 class="h1">Auckland, we’ve had enough.</h1>
      </div>
    </SnapSection>

    <SnapSection variant="white" id="deserve">
      <div class="center">
        <h1 class="h1">You deserve better.</h1>
      </div>
    </SnapSection>

    <!-- Good sequence -->
    <SnapSection variant="image" image="/images/good-1.png" id="good-1">

    </SnapSection>

    <SnapSection variant="image" image="/images/good-2.png" id="good-2">

    </SnapSection>

    <SnapSection variant="image" image="/images/good-3.png" id="no-surprises">

    </SnapSection>

    <SnapSection variant="white" id="tristar">
      <div class="center">
        <h1 class="h1">This is Tri Star Electrical.</h1>
      </div>
    </SnapSection>

    <!-- Final CTA -->
    <SnapSection variant="black" id="contact">
      <div class="center">
        <h1 class="h1">Ready to work with the professionals?</h1>
        <div class="ctaColumn">
          <a class="linkBtn" href=/contact#form>Contact Now</a>
        </div>
        <div class="menuRow">
          <a class="linkText" href=/services>Services</a>
          <a class="linkText" href=/about>About</a>
          <a class="linkText" href=/contact>Contact</a>
        </div>
    </SnapSection>
  </main>

  <!-- Optional: tighter snap on mousewheel so one wheel = one section -->
  <script>
    (() => {
      const root = document.getElementById("snapRoot");
      if (!root) return;

      let lock = false;
      root.addEventListener("wheel", (e) => {
        if (lock) return;
        const dy = e.deltaY;
        if (Math.abs(dy) < 12) return;

        const sections = Array.from(root.querySelectorAll("[data-snap-section]"));
        const y = root.scrollTop + root.clientHeight / 2;

        let idx = 0;
        for (let i = 0; i < sections.length; i++) {
          const top = sections[i].offsetTop;
          const bottom = top + sections[i].offsetHeight;
          if (y >= top && y < bottom) { idx = i; break; }
        }

        const next = dy > 0 ? Math.min(idx + 1, sections.length - 1) : Math.max(idx - 1, 0);
        if (next === idx) return;

        e.preventDefault();
        lock = true;
        root.scrollTo({ top: sections[next].offsetTop, behavior: "smooth" });
        setTimeout(() => (lock = false), 420);
      }, { passive: false });
    })();
  </script>
</BaseLayout>
